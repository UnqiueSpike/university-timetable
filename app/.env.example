# Local-only example password, not a real service credential. Never reuse in deployment.
DATABASE_URL=postgresql://unischedule:local-development-only@127.0.0.1:55432/unischedule_dev
# Tests create and remove their own uniquely named database on this local server.
TEST_DATABASE_URL=postgresql://unischedule:local-development-only@127.0.0.1:55432/unischedule_test
# Explicit opt-in, in addition to loopback host and development database name checks.
ALLOW_TEST_SEED=true
