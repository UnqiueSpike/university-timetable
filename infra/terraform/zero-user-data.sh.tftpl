#!/bin/bash
set -euo pipefail
umask 077
dnf install -y docker jq
systemctl enable --now docker
mkdir -p /var/lib/unischedule-zero
for attempt in $(seq 1 120); do
  device=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${volume_id}
  [ -e "$device" ] && break
  sleep 5
done
[ -e "$device" ]
# A persistent volume is formatted only when no filesystem exists.
blkid "$device" || mkfs -t xfs "$device"
mount "$device" /var/lib/unischedule-zero
chown 1000:1000 /var/lib/unischedule-zero
uuid=$(blkid -s UUID -o value "$device")
echo "UUID=$uuid /var/lib/unischedule-zero xfs defaults,nofail 0 2" >> /etc/fstab
aws secretsmanager get-secret-value --region '${region}' --secret-id '${secret_arn}' --query SecretString --output text | jq -r 'to_entries[] | "\(.key)=\(.value)"' > /run/unischedule-zero.env
cat >> /run/unischedule-zero.env <<'CONFIG'
ZERO_PORT=4848
ZERO_APP_ID=unischedule
ZERO_APP_PUBLICATIONS=unischedule_sync
ZERO_QUERY_URL=https://${app_domain}/api/sync/query
ZERO_MUTATE_URL=https://${app_domain}/api/sync/mutate
ZERO_REPLICA_FILE=/data/replica.db
ZERO_ENABLE_CRUD_MUTATIONS=false
ZERO_ENABLE_TELEMETRY=false
ZERO_NUM_SYNC_WORKERS=1
ZERO_LOG_LEVEL=warn
CONFIG
aws ecr get-login-password --region '${region}' | docker login --username AWS --password-stdin "$(echo ${image} | cut -d/ -f1)"
docker pull '${image}'
docker run -d --name unischedule-zero --restart unless-stopped --env-file /run/unischedule-zero.env -p 4848:4848 -v /var/lib/unischedule-zero:/data --log-driver awslogs --log-opt awslogs-region='${region}' --log-opt awslogs-group='${log_group}' --log-opt awslogs-stream=zero '${image}' node node_modules/@rocicorp/zero/out/zero/src/cli.js
rm /run/unischedule-zero.env
